# Copy to .env and adjust. Never commit .env.
# Leave optional variables commented out rather than empty.

# Folder on the host with your app projects (mounted at /workspace)
PROJECTS_DIR=./workspace

# Match your host user so files created in /workspace are yours (run: id -u / id -g)
USER_UID=1000
USER_GID=1000

# Claude Code auth: either set an API key, or leave it commented out and run
# `claude` then /login inside the container (the login persists in a volume).
# ANTHROPIC_API_KEY=sk-ant-...

# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# Android devices - pick ONE approach (see README):
#  a) use the adb server on the host (start it with: adb -a nodaemon server start)
# ADB_HOST_SERVER=host.docker.internal:5037
#  b) connect to a device/emulator over TCP / Wi-Fi debugging
# ADB_CONNECT=192.168.1.50:5555

# Expo / EAS cloud builds (the way to get iOS builds from Linux)
# EXPO_TOKEN=

# Build-time versions (used by `docker compose build`)
FLUTTER_VERSION=3.47.9
NODE_MAJOR=24
ANDROID_PLATFORM=android-36
ANDROID_BUILD_TOOLS=36.0.0
# ANDROID_NDK=27.1.12297006
INSTALL_EMULATOR=false
CLAUDE_CODE_VERSION=latest
