{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter doctor:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(./gradlew:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(yarn test:*)",
      "Bash(yarn lint:*)",
      "Bash(adb devices:*)",
      "Bash(adb logcat:*)",
      "Bash(sdkmanager --list:*)",
      "Bash(devenv-doctor:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/key.properties)"
    ]
  }
}
